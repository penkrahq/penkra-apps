{
  "id": "com.penkra.canvas",
  "slug": "canvas",
  "name": "Canvas",
  "summary": "Create, edit, review, and share Account-owned collaborative design documents.",
  "version": "0.2.63",
  "compatibility": {
    "penkra": ">=0.11.15"
  },
  "icons": [
    {
      "src": "assets/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "entrypoints": {
    "tab": "app.html",
    "controller": "operations.js"
  },
  "permissions": [
    {
      "name": "account-data",
      "required": true,
      "reason": "Canvas stores and synchronizes your Account-owned design documents and sharing grants."
    },
    {
      "name": "network-fetch",
      "required": true,
      "reason": "Canvas loads the exact font faces used by a design through host-validated online font providers."
    }
  ],
  "operations": [
    {
      "key": "documents.list",
      "instructionsPath": "operations/documents.list.md",
      "summary": "Find Account-owned and shared Canvas documents and resolve the exact document ID needed by later operations.",
      "input": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 255,
            "description": "Optional case-insensitive title filter."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "description": "Maximum matching documents to return."
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "ownerAccountId": {
                  "type": "string"
                },
                "ownerName": {
                  "type": ["string", "null"]
                },
                "access": {
                  "enum": ["owner", "editor"]
                },
                "createdAt": {
                  "type": "string"
                },
                "updatedAt": {
                  "type": "string"
                },
                "lastOpenedAt": {
                  "type": ["string", "null"]
                }
              },
              "required": [
                "id",
                "title",
                "ownerAccountId",
                "ownerName",
                "access",
                "createdAt",
                "updatedAt",
                "lastOpenedAt"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": ["items"],
        "additionalProperties": false
      },
      "examples": [
        {
          "name": "Find documents by title",
          "input": {
            "query": "Draft",
            "limit": 20
          }
        }
      ],
      "handler": "documents.list"
    },
    {
      "key": "documents.create",
      "summary": "Create a blank Account-owned Canvas document. Use documents.execute to add or inspect design content.",
      "instructionsPath": "operations/documents.create.md",
      "input": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "Title shown in Canvas and document lists."
          },
          "module": { "enum": ["generic", "deck", "web", "mobile"], "description": "Canvas module. A generic document may set a deliverable module later while it has no role-bearing frames." },
          "preset": { "enum": ["a4", "letter"], "description": "Optional physical-size preset for a generic blank document." }
        },
        "required": ["title", "module"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "access": {
            "const": "owner"
          },
          "starterFrameId": {
            "type": "string",
            "minLength": 1,
            "description": "Exact ID of the blank document's initial 720×480 frame."
          }
        },
        "required": ["documentId", "title", "access", "starterFrameId"],
        "additionalProperties": false
      },
      "examples": [
        {
          "name": "Create a Canvas document",
          "input": {
            "title": "New Canvas design",
            "module": "web"
          }
        }
      ],
      "handler": "documents.create"
    },
    {
      "key": "documents.execute",
      "summary": "Read or change one Canvas design with bounded JavaScript; keep each execution focused on one coherent design intent.",
      "instructionsPath": "operations/documents.execute.md",
      "input": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string",
            "format": "uuid",
            "description": "Exact document returned by documents.list or documents.create."
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000,
            "description": "JavaScript using Get, Insert, Copy, Update, Replace, Delete, Move, G, TakeScreenshot, and Print."
          }
        },
        "required": ["documentId", "code"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string"
          },
          "changed": {
            "type": "boolean"
          },
          "sequence": {
            "type": "integer",
            "minimum": 0
          },
          "operationId": {
            "type": ["string", "null"],
            "description": "Durable ID for a committed mutation, or null for a read-only execution. The ID is undoable only while that mutation remains the document head."
          },
          "prints": {
            "type": "array",
            "maxItems": 1000
          },
          "result": {},
          "touchedNodeIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 10000
          },
          "inspection": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            },
            "maxItems": 10000
          },
          "issues": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "screenshots": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "nodeIds": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                "width": { "type": "integer", "minimum": 1 },
                "height": { "type": "integer", "minimum": 1 },
                "mimeType": { "const": "image/png" }
              },
              "required": ["nodeIds", "width", "height", "mimeType"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "documentId",
          "changed",
          "operationId",
          "sequence",
          "prints",
          "result",
          "touchedNodeIds",
          "inspection",
          "issues",
          "screenshots"
        ],
        "additionalProperties": false
      },
      "examples": [
        {
          "name": "Inspect frames with resolved bounds and problems",
          "input": {
            "documentId": "092d8d0f-8a53-4e95-b9ff-7ec6e222ddf9",
            "code": "return Get(\"type:frame\", ({ node, parent, bounds, problems }) => Print({ id: node.id, name: node.name ?? null, parentId: parent?.id ?? null, bounds, problems }), { limit: 100 });"
          }
        },
        {
          "name": "Update one exact frame name",
          "input": {
            "documentId": "092d8d0f-8a53-4e95-b9ff-7ec6e222ddf9",
            "code": "Update(\"#frame-id\", { name: \"Updated frame name\" });\nreturn \"frame-id\";"
          }
        },
        {
          "name": "Insert one layout container",
          "input": {
            "documentId": "092d8d0f-8a53-4e95-b9ff-7ec6e222ddf9",
            "code": "Insert(null, { id: \"content-frame\", type: \"frame\", name: \"Content frame\", x: 0, y: 0, width: 800, height: 600, layout: \"vertical\", padding: 24, gap: 16, fill: \"#ffffff\", children: [] });\nreturn \"content-frame\";"
          }
        },
        {
          "name": "Generate an image for an exact target",
          "input": {
            "documentId": "092d8d0f-8a53-4e95-b9ff-7ec6e222ddf9",
            "code": "G(\"#image-target\", \"ai\", \"Specific subject and setting, intentional composition, defined visual style and palette, clear lighting, useful negative space, exact crop, no text\");\nreturn \"image-target\";"
          }
        },
        {
          "name": "Insert a standard library icon",
          "input": {
            "documentId": "092d8d0f-8a53-4e95-b9ff-7ec6e222ddf9",
            "code": "Insert(\"#icon-container\", { id: \"help-icon\", type: \"icon\", library: \"lucide\", icon: \"circle-help\", width: 20, height: 20, fill: \"#20211d\" });\nreturn \"help-icon\";"
          }
        },
        {
          "name": "Replace a starter frame and visually verify it",
          "input": {
            "documentId": "092d8d0f-8a53-4e95-b9ff-7ec6e222ddf9",
            "code": "const starter = Get(\"type:frame\")[0];\nconst frame = Replace(`#${starter.node.id}`, { id: \"content-frame\", type: \"frame\", name: \"Content frame\", x: 0, y: 0, width: 800, height: 600, layout: \"none\", fill: \"#ffffff\", children: [] });\nTakeScreenshot([frame]);\nreturn frame;"
          }
        }
      ],
      "handler": "documents.execute"
    },
    {
      "key": "documents.undo",
      "summary": "Undo the latest agent documents.execute mutation while it remains the exact document head.",
      "instructions": "This reverses one complete mutating documents.execute operation; it does not manipulate the editor's local undo stack and does not reconstruct an older document. Pass the returned operationId when available. If an execute call timed out after committing and its result was lost, omit operationId to resolve and undo the exact current head agent operation. Canvas rejects the request if a UI, collaborator, or later agent edit has advanced the document, if the operation was already undone, or if the caller did not author it. After rejection, inspect the current document instead of guessing or replaying stale changes.",
      "input": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string",
            "format": "uuid",
            "description": "Exact document containing the agent operation to undo."
          },
          "operationId": {
            "type": "string",
            "format": "uuid",
            "description": "Durable operationId returned by the mutating documents.execute call. Omit only when its result was lost after a possible commit."
          }
        },
        "required": ["documentId"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "documentId": { "type": "string", "format": "uuid" },
          "operationId": { "type": "string", "format": "uuid" },
          "changed": { "const": true },
          "sequence": { "type": "integer", "minimum": 1 }
        },
        "required": ["documentId", "operationId", "changed", "sequence"],
        "additionalProperties": false
      },
      "examples": [
        {
          "name": "Undo one exact agent operation",
          "input": {
            "documentId": "092d8d0f-8a53-4e95-b9ff-7ec6e222ddf9",
            "operationId": "aa9a67db-63bf-4cba-937b-f9f0406eecb4"
          }
        }
      ],
      "handler": "documents.undo"
    },
    {
      "key": "documents.export",
      "summary": "Export role-bearing Canvas frames to PowerPoint or HTML. Native SwiftUI and Compose export is temporarily unavailable.",
      "input": {
        "type": "object",
        "properties": {
          "documentId": { "type": "string", "format": "uuid" },
          "format": { "enum": ["pptx", "html", "swift", "kotlin"], "description": "Available: pptx and html. swift and kotlin return CANVAS_EXPORT_FORMAT_UNAVAILABLE while native mobile fidelity is being verified." },
          "frames": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "type": "string", "minLength": 1 } },
          "destination": { "type": "string", "minLength": 1, "description": "Absolute file path for slide or absolute directory path for route/ios/android. Existing destinations are rejected." },
          "modes": { "type": "object", "additionalProperties": { "type": "string" } },
          "bindings": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "type": "object", "required": ["output"], "properties": { "output": { "type": "string", "minLength": 1 } }, "additionalProperties": true } }
        },
        "required": ["documentId", "format", "destination"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "artifacts": { "type": "array", "items": { "type": "string" } },
          "consequences": { "type": "array" },
          "lowered": { "type": "array" },
          "embeddedFonts": { "type": "array" },
          "bundledFonts": { "type": "array" },
          "rasterized": { "type": "array" }
        },
        "required": ["artifacts", "consequences", "lowered", "embeddedFonts", "rasterized"],
        "additionalProperties": false
      },
      "examples": [
        {
          "name": "Export selected slides as PowerPoint",
          "input": {
            "documentId": "092d8d0f-8a53-4e95-b9ff-7ec6e222ddf9",
            "format": "pptx",
            "frames": ["slide-1", "slide-2"],
            "destination": "/Users/example/Downloads/deck.pptx"
          }
        }
      ],
      "handler": "documents.export"
    },
    {
      "key": "documents.extract",
      "summary": "Extract Canvas nodes as PNG, SVG or a multi-page PDF without requiring an export role.",
      "input": {
        "type": "object",
        "properties": {
          "documentId": { "type": "string", "format": "uuid" },
          "node": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "Exact nodes in artifact order. Several nodes can share one PDF file." },
          "format": { "enum": ["png", "svg", "pdf"] },
          "profile": { "enum": ["PDF/X-4"], "description": "PDF-only print profile using the bundled output condition; serialized output must pass the Canvas writer preflight." },
          "scale": { "type": "number", "exclusiveMinimum": 0, "maximum": 8 },
          "destination": { "type": "string", "minLength": 1, "description": "Absolute path. A trailing / creates a new directory containing <nodeId>.<format> per node; otherwise use this exact filename. Existing destinations and filename collisions are errors." },
          "modes": { "type": "object", "additionalProperties": { "type": "string" } }
        },
        "required": ["documentId", "node", "format", "destination"],
        "additionalProperties": false
      },
      "output": { "type": "object", "additionalProperties": true },
      "examples": [
        {
          "name": "Export one subtree as a two-times PNG",
          "input": {
            "documentId": "092d8d0f-8a53-4e95-b9ff-7ec6e222ddf9",
            "node": ["frame-1"],
            "format": "png",
            "scale": 2,
            "destination": "/Users/example/Downloads/frame-1.png"
          }
        }
      ],
      "handler": "documents.extract"
    },
    {
      "key": "libraries.publish",
      "summary": "Publish the exact current Canvas library public surface with a revision-guarded document head update.",
      "input": {
        "type": "object",
        "properties": {
          "documentId": { "type": "string", "format": "uuid" },
          "publicItems": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": { "enum": ["variable", "paragraphStyle", "component"] },
                "id": { "type": "string", "minLength": 1 }
              },
              "required": ["kind", "id"],
              "additionalProperties": false
            }
          }
        },
        "required": ["documentId"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "documentId": { "type": "string", "format": "uuid" },
          "published": { "const": true },
          "operationId": { "type": "string", "format": "uuid" },
          "sequence": { "type": "integer", "minimum": 1 },
          "publication": {
            "type": "object",
            "properties": {
              "releaseId": { "type": "string", "format": "uuid" },
              "contentHash": { "type": "string", "minLength": 64, "maxLength": 64 },
              "storage": {
                "type": "object",
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
                  "size": { "type": "integer", "minimum": 0 },
                  "mimeType": { "type": "string" }
                },
                "required": ["path", "sha256", "size"],
                "additionalProperties": false
              }
            },
            "required": ["releaseId", "contentHash", "storage"],
            "additionalProperties": false
          },
          "snapshot": {
            "type": "object",
            "properties": {
              "status": { "enum": ["saved", "deferred"] },
              "code": { "const": "CANVAS_LIBRARY_SNAPSHOT_DEFERRED" }
            },
            "required": ["status"],
            "additionalProperties": false
          }
        },
        "required": ["documentId", "published", "operationId", "sequence", "publication", "snapshot"],
        "additionalProperties": false
      },
      "examples": [
        {
          "name": "Publish a Canvas card library",
          "input": {
            "documentId": "092d8d0f-8a53-4e95-b9ff-7ec6e222ddf9",
            "publicItems": [{ "kind": "component", "id": "card" }]
          }
        }
      ],
      "handler": "libraries.publish"
    },
    {
      "key": "libraries.inspect",
      "summary": "Inspect the validated public items and identity of one currently published Canvas library without changing it.",
      "input": {
        "type": "object",
        "properties": {
          "documentId": { "type": "string", "format": "uuid" }
        },
        "required": ["documentId"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "documentId": { "type": "string", "format": "uuid" },
          "publication": {
            "type": "object",
            "properties": {
              "releaseId": { "type": "string", "format": "uuid" },
              "contentHash": { "type": "string", "minLength": 64, "maxLength": 64 }
            },
            "required": ["releaseId", "contentHash"],
            "additionalProperties": false
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": { "enum": ["component", "paragraphStyle", "variable"] },
                "id": { "type": "string", "minLength": 1 },
                "contentHash": { "type": "string", "minLength": 64, "maxLength": 64 }
              },
              "required": ["kind", "id", "contentHash"],
              "additionalProperties": false
            }
          }
        },
        "required": ["documentId", "publication", "items"],
        "additionalProperties": false
      },
      "examples": [
        {
          "name": "Inspect the published Canvas library surface",
          "input": {
            "documentId": "092d8d0f-8a53-4e95-b9ff-7ec6e222ddf9"
          }
        }
      ],
      "handler": "libraries.inspect"
    },
    {
      "key": "libraries.accept",
      "summary": "Accept selected public items from one published Canvas library into an exact consumer document as a retained import.",
      "input": {
        "type": "object",
        "properties": {
          "documentId": { "type": "string", "format": "uuid" },
          "libraryId": { "type": "string", "format": "uuid" },
          "alias": { "type": "string", "minLength": 1 },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "kind": { "enum": ["variable", "paragraphStyle", "component"] },
                "id": { "type": "string", "minLength": 1 }
              },
              "required": ["kind", "id"],
              "additionalProperties": false
            }
          },
          "updatePolicy": { "enum": ["follow", "pinned"] }
        },
        "required": ["documentId", "libraryId", "alias", "items"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "accepted": { "const": true },
          "changed": { "type": "boolean" },
          "documentId": { "type": "string", "format": "uuid" },
          "alias": { "type": "string", "minLength": 1 },
          "identity": {
            "type": "object",
            "properties": {
              "libraryId": { "type": "string" },
              "releaseId": { "type": "string" },
              "contentHash": { "type": "string", "minLength": 64, "maxLength": 64 }
            },
            "required": ["libraryId", "releaseId", "contentHash"],
            "additionalProperties": false
          },
          "retention": {
            "type": "object",
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
              "size": { "type": "integer", "minimum": 0 },
              "mimeType": { "type": "string" }
            },
            "required": ["path", "sha256", "size"],
            "additionalProperties": false
          },
          "sequence": { "type": "integer", "minimum": 0 },
          "operationId": { "type": "string", "format": "uuid" },
          "snapshot": {
            "type": "object",
            "properties": {
              "status": { "enum": ["saved", "deferred"] },
              "code": { "const": "CANVAS_LIBRARY_SNAPSHOT_DEFERRED" }
            },
            "required": ["status"],
            "additionalProperties": false
          }
        },
        "required": ["accepted", "changed", "documentId", "alias", "identity", "retention", "sequence"],
        "additionalProperties": false
      },
      "examples": [
        {
          "name": "Accept a published Canvas card",
          "input": {
            "documentId": "092d8d0f-8a53-4e95-b9ff-7ec6e222ddf9",
            "libraryId": "7e8d9c0a-1b2c-4d3e-8f90-a1b2c3d4e5f6",
            "alias": "ui",
            "items": [{ "kind": "component", "id": "card" }],
            "updatePolicy": "follow"
          }
        }
      ],
      "handler": "libraries.accept"
    },
    {
      "key": "documents.open",
      "summary": "Open one exact Canvas document in a new or explicitly targeted tab for the user.",
      "instructions": "Opening changes visible tab state but does not modify document content. Use documents.execute with TakeScreenshot for document visual inspection; open a tab when the user should view or work in the Canvas editor.",
      "input": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["documentId"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string"
          },
          "tabId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["documentId", "tabId"],
        "additionalProperties": false
      },
      "examples": [
        {
          "name": "Open a document for visual review",
          "input": {
            "documentId": "092d8d0f-8a53-4e95-b9ff-7ec6e222ddf9"
          }
        }
      ],
      "handler": "documents.open"
    },
    {
      "key": "documents.trash",
      "summary": "Move one owned Canvas document to recoverable Trash after explicit user authorization and exact current-title confirmation.",
      "instructions": "Resolve the exact current title with documents.list, obtain explicit authorization to move that document to Trash, and pass the title unchanged as confirmTitle. Edit or cleanup authorization does not imply moving the document to Trash. Agents cannot permanently delete Canvas documents.",
      "input": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string",
            "format": "uuid"
          },
          "confirmTitle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "required": ["documentId", "confirmTitle"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "trashed": {
            "const": true
          }
        },
        "required": ["documentId", "title", "trashed"],
        "additionalProperties": false
      },
      "examples": [
        {
          "name": "Move an explicitly confirmed test document to Trash",
          "input": {
            "documentId": "092d8d0f-8a53-4e95-b9ff-7ec6e222ddf9",
            "confirmTitle": "Canvas QA Test"
          }
        }
      ],
      "handler": "documents.trash"
    },
    {
      "key": "sharing.list",
      "instructionsPath": "operations/sharing.list.md",
      "summary": "List current editors and pending Account email grants for one owned document before changing access.",
      "input": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string",
