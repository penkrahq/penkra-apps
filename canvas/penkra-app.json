{
  "id": "com.penkra.canvas",
  "slug": "canvas",
  "name": "Canvas",
  "summary": "Create, edit, review, and share Account-owned collaborative design documents.",
  "version": "0.2.84",
  "compatibility": {
    "penkra": ">=0.12.6"
  },
  "icons": [
    {
      "src": "assets/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "entrypoints": {
    "tab": "app.html",
    "controller": "operations.js"
  },
  "permissions": [
    {
      "name": "account-data",
      "required": true,
      "reason": "Canvas stores and synchronizes your Account-owned design documents and sharing grants."
    },
    {
      "name": "account-profile",
      "required": true,
      "reason": "Canvas shows your signed-in name and profile picture in collaboration controls."
    },
    {
      "name": "network-fetch",
      "required": true,
      "reason": "Canvas loads the exact font faces used by a design through host-validated online font providers."
    }
  ],
  "operations": [
    {
      "key": "icons.search",
      "instructionsPath": "operations/icons.search.md",
      "summary": "Search Canvas's bundled icon catalogs and return exact library and icon identifiers for native icon nodes.",
      "input": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Words expected in the icon name, such as loader, school, arrow left, or progress activity."
          },
          "library": {
            "enum": ["lucide", "feather", "Material Symbols Outlined", "Material Symbols Rounded", "Material Symbols Sharp", "phosphor"],
            "description": "Optional exact Canvas icon library. Omit it to search every bundled library."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 40,
            "description": "Maximum matches to return."
          }
        },
        "required": ["query"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "library": { "type": "string" },
                "icon": { "type": "string" }
              },
              "required": ["library", "icon"],
              "additionalProperties": false
            }
          },
          "total": { "type": "integer", "minimum": 0 },
          "truncated": { "type": "boolean" }
        },
        "required": ["items", "total", "truncated"],
        "additionalProperties": false
      },
      "examples": [
        {
          "name": "Find a loading-state icon",
          "input": { "query": "loader", "library": "lucide", "limit": 20 }
        }
      ],
      "handler": "icons.search"
    },
    {
      "key": "documents.list",
      "instructionsPath": "operations/documents.list.md",
      "summary": "Find Account-owned and shared Canvas documents and resolve the exact document ID needed by later operations.",
      "input": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 255,
            "description": "Optional case-insensitive title filter."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "description": "Maximum matching documents to return."
          },
          "view": {
            "enum": ["all", "root", "folder", "recent"],
            "description": "Collection to search. Use folder with folderId for one folder's immediate designs."
          },
          "folderId": {
            "type": "string",
            "format": "uuid",
            "description": "Folder used when view is folder."
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "ownerAccountId": {
                  "type": "string"
                },
                "ownerName": {
                  "type": ["string", "null"]
                },
                "access": {
                  "enum": ["owner", "editor"]
                },
                "createdAt": {
                  "type": "string"
                },
                "updatedAt": {
                  "type": "string"
                },
                "lastOpenedAt": {
                  "type": ["string", "null"]
                },
                "folderId": {
                  "type": ["string", "null"]
                },
                "folderName": {
                  "type": ["string", "null"]
                },
                "lastEditor": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "accountId": { "type": "string" },
                        "name": { "type": ["string", "null"] },
                        "avatarUrl": { "type": ["string", "null"] },
                        "isCurrentUser": { "type": "boolean" }
                      },
                      "required": ["accountId", "name", "avatarUrl", "isCurrentUser"],
                      "additionalProperties": false
                    },
                    { "type": "null" }
                  ]
                },
                "thumbnailUpdatedAt": {
                  "type": ["string", "null"]
                }
              },
              "required": [
                "id",
                "title",
                "ownerAccountId",
                "ownerName",
                "access",
                "createdAt",
                "updatedAt",
                "lastOpenedAt",
                "folderId",
                "folderName",
                "lastEditor",
                "thumbnailUpdatedAt"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": ["items"],
        "additionalProperties": false
      },
      "examples": [
        {
          "name": "Find documents by title",
          "input": {
            "query": "Draft",
            "limit": 20
          }
        }
      ],
      "handler": "documents.list"
    },
    {
      "key": "documents.create",
      "summary": "Create a blank Account-owned Canvas document. Use documents.execute to add or inspect design content.",
      "instructionsPath": "operations/documents.create.md",
      "input": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "Title shown in Canvas and document lists."
          },
          "module": { "enum": ["generic", "deck", "web", "mobile"], "description": "Canvas module. A generic document may set a deliverable module later while it has no role-bearing frames." },
          "preset": { "enum": ["a4", "letter"], "description": "Optional physical-size preset for a generic blank document." }
          ,
          "folderId": { "type": ["string", "null"], "format": "uuid", "description": "Optional folder that should contain the new design." }
        },
        "required": ["title", "module"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "access": {
            "const": "owner"
          },
          "starterFrameId": {
            "type": "string",
            "minLength": 1,
            "description": "Exact ID of the blank document's initial 720×480 frame."
          },
          "folderId": {
            "type": ["string", "null"],
            "format": "uuid"
          }
        },
        "required": ["documentId", "title", "access", "folderId", "starterFrameId"],
        "additionalProperties": false
      },
      "examples": [
        {
          "name": "Create a Canvas document",
          "input": {
            "title": "New Canvas design",
            "module": "web"
          }
        }
      ],
      "handler": "documents.create"
    },
    {
      "key": "documents.move",
      "summary": "Move one editable Canvas document to a folder or to the root library.",
      "input": {
        "type": "object",
        "properties": {
          "documentId": { "type": "string", "format": "uuid" },
          "folderId": { "type": ["string", "null"], "format": "uuid", "description": "Destination folder, or null for the root library." }
        },
        "required": ["documentId", "folderId"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "documentId": { "type": "string", "format": "uuid" },
          "folderId": { "type": ["string", "null"], "format": "uuid" }
        },
        "required": ["documentId", "folderId"],
        "additionalProperties": false
      },
      "examples": [{ "name": "Move a design to the root library", "input": { "documentId": "092d8d0f-8a53-4e95-b9ff-7ec6e222ddf9", "folderId": null } }],
      "handler": "documents.move"
    },
    {
      "key": "documents.duplicate",
      "summary": "Duplicate one readable Canvas document into an editable destination folder.",
      "input": {
        "type": "object",
        "properties": {
          "documentId": { "type": "string", "format": "uuid" },
          "title": { "type": "string", "minLength": 1, "maxLength": 255 },
          "folderId": { "type": ["string", "null"], "format": "uuid", "description": "Destination folder. Omit to keep the duplicate beside the source." }
        },
        "required": ["documentId", "title"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "documentId": { "type": "string", "format": "uuid" },
          "title": { "type": "string" },
          "folderId": { "type": ["string", "null"], "format": "uuid" }
        },
        "required": ["documentId", "title", "folderId"],
        "additionalProperties": false
      },
      "examples": [{ "name": "Duplicate a design beside its source", "input": { "documentId": "092d8d0f-8a53-4e95-b9ff-7ec6e222ddf9", "title": "Design variation" } }],
      "handler": "documents.duplicate"
    },
    {
      "key": "documents.execute",
      "summary": "Read or change one Canvas design with bounded JavaScript; keep each execution focused on one coherent design intent.",
      "instructionsPath": "operations/documents.execute.md",
      "input": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string",
            "format": "uuid",
            "description": "Exact document returned by documents.list or documents.create."
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000,
            "description": "JavaScript using Get, Insert, Copy, Update, Replace, Delete, Move, G, ConvertSvgToVectors, TakeScreenshot, and Print."
          }
        },
        "required": ["documentId", "code"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string"
          },
          "changed": {
            "type": "boolean"
          },
          "sequence": {
            "type": "integer",
            "minimum": 0
          },
          "operationId": {
            "type": ["string", "null"],
            "description": "Durable ID for a committed mutation, or null for a read-only execution. The ID is undoable only while that mutation remains the document head."
          },
          "prints": {
            "type": "array",
            "maxItems": 1000
          },
          "result": {},
          "touchedNodeIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 10000
          },
          "svgConversions": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "properties": {
                "sourceNodeId": { "type": "string" },
                "createdNodeId": { "type": "string" },
                "shapeCount": { "type": "integer", "minimum": 1 },
                "mode": { "enum": ["copy", "replace"] },
                "fidelity": { "const": "exact" },
                "warnings": { "type": "array", "maxItems": 0 }
              },
              "required": ["sourceNodeId", "createdNodeId", "shapeCount", "mode", "fidelity", "warnings"],
              "additionalProperties": false
            }
          },
          "inspection": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            },
            "maxItems": 10000
          },
          "issues": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "screenshots": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "nodeIds": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                "width": { "type": "integer", "minimum": 1 },
                "height": { "type": "integer", "minimum": 1 },
                "mimeType": { "const": "image/png" }
              },
              "required": ["nodeIds", "width", "height", "mimeType"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "documentId",
          "changed",
          "operationId",
          "sequence",
          "prints",
          "result",
          "touchedNodeIds",
          "svgConversions",
          "inspection",
          "issues",
          "screenshots"
        ],
        "additionalProperties": false
      },
      "examples": [
        {
          "name": "Inspect frames with resolved bounds and problems",
          "input": {
            "documentId": "092d8d0f-8a53-4e95-b9ff-7ec6e222ddf9",
            "code": "return Get(\"type:frame\", ({ node, parent, bounds, problems }) => Print({ id: node.id, name: node.name ?? null, parentId: parent?.id ?? null, bounds, problems }), { limit: 100 });"
          }
        },
        {
          "name": "Update one exact frame name",
          "input": {
            "documentId": "092d8d0f-8a53-4e95-b9ff-7ec6e222ddf9",
            "code": "Update(\"#frame-id\", { name: \"Updated frame name\" });\nreturn \"frame-id\";"
          }
        },
        {
          "name": "Insert one layout container",
          "input": {
            "documentId": "092d8d0f-8a53-4e95-b9ff-7ec6e222ddf9",
            "code": "Insert(null, { id: \"content-frame\", type: \"frame\", name: \"Content frame\", x: 0, y: 0, width: 800, height: 600, layout: \"vertical\", padding: 24, gap: 16, fill: \"#ffffff\", children: [] });\nreturn \"content-frame\";"
          }
        },
        {
          "name": "Generate an image for an exact target",
          "input": {
            "documentId": "092d8d0f-8a53-4e95-b9ff-7ec6e222ddf9",
            "code": "G(\"#image-target\", \"ai\", \"Specific subject and setting, intentional composition, defined visual style and palette, clear lighting, useful negative space, exact crop, no text\");\nreturn \"image-target\";"
          }
        },
        {
          "name": "Insert a standard library icon",
          "input": {
            "documentId": "092d8d0f-8a53-4e95-b9ff-7ec6e222ddf9",
            "code": "Insert(\"#icon-container\", { id: \"help-icon\", type: \"icon\", library: \"lucide\", icon: \"circle-help\", width: 20, height: 20, fill: \"#20211d\" });\nreturn \"help-icon\";"
          }
        },
        {
          "name": "Replace a starter frame and visually verify it",
          "input": {
            "documentId": "092d8d0f-8a53-4e95-b9ff-7ec6e222ddf9",
            "code": "const starter = Get(\"type:frame\")[0];\nconst frame = Replace(`#${starter.node.id}`, { id: \"content-frame\", type: \"frame\", name: \"Content frame\", x: 0, y: 0, width: 800, height: 600, layout: \"none\", fill: \"#ffffff\", children: [] });\nTakeScreenshot([frame]);\nreturn frame;"
          }
        }
      ],
      "handler": "documents.execute"
    },
    {
      "key": "documents.undo",
      "summary": "Undo the latest agent documents.execute mutation while it remains the exact document head.",
      "instructions": "This reverses one complete mutating documents.execute operation; it does not manipulate the editor's local undo stack and does not reconstruct an older document. Pass the returned operationId when available. If an execute call timed out after committing and its result was lost, omit operationId to resolve and undo the exact current head agent operation. Canvas rejects the request if a UI, collaborator, or later agent edit has advanced the document, if the operation was already undone, or if the caller did not author it. After rejection, inspect the current document instead of guessing or replaying stale changes.",
      "input": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string",
            "format": "uuid",
            "description": "Exact document containing the agent operation to undo."
          },
          "operationId": {
            "type": "string",
            "format": "uuid",
            "description": "Durable operationId returned by the mutating documents.execute call. Omit only when its result was lost after a possible commit."
          }
        },
        "required": ["documentId"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "documentId": { "type": "string", "format": "uuid" },
          "operationId": { "type": "string", "format": "uuid" },
          "changed": { "const": true },
          "sequence": { "type": "integer", "minimum": 1 }
        },
        "required": ["documentId", "operationId", "changed", "sequence"],
        "additionalProperties": false
      },
      "examples": [
        {
          "name": "Undo one exact agent operation",
          "input": {
            "documentId": "092d8d0f-8a53-4e95-b9ff-7ec6e222ddf9",
            "operationId": "aa9a67db-63bf-4cba-937b-f9f0406eecb4"
          }
        }
      ],
      "handler": "documents.undo"
    },
    {
      "key": "documents.export",
      "summary": "Export explicit role-bearing Canvas frames to their native deck, web, or mobile artifact.",
      "input": {
        "type": "object",
        "properties": {
          "documentId": { "type": "string", "format": "uuid" },
          "role": { "enum": ["slide", "route", "ios", "android"] },
          "frames": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "type": "string", "minLength": 1 } },
          "destination": { "type": "string", "minLength": 1, "description": "Absolute file path for slide or absolute directory path for route/ios/android. Existing destinations are rejected." },
          "modes": { "type": "object", "additionalProperties": { "type": "string" } },
          "bindings": { "type": "array", "maxItems": 1000, "items": { "type": "object", "required": ["output"], "properties": { "output": { "type": "string", "minLength": 1 } }, "additionalProperties": true } }
        },
        "required": ["documentId", "role", "frames", "destination"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "artifacts": { "type": "array", "items": { "type": "string" } },
          "consequences": { "type": "array" },
          "lowered": { "type": "array" },
          "embeddedFonts": { "type": "array" },
          "bundledFonts": { "type": "array" },
          "rasterized": { "type": "array" }
        },
        "required": ["artifacts", "consequences", "lowered", "embeddedFonts", "bundledFonts", "rasterized"],
        "additionalProperties": false
      },
      "examples": [
        {
          "name": "Export selected slides as PowerPoint",
          "input": {
            "documentId": "092d8d0f-8a53-4e95-b9ff-7ec6e222ddf9",
            "role": "slide",
            "frames": ["slide-1", "slide-2"],
            "destination": "/Users/example/Downloads/deck.pptx"
          }
        }
      ],
      "handler": "documents.export"
    },
    {
      "key": "documents.extract",
      "summary": "Extract Canvas nodes as PNG, SVG or a multi-page PDF without requiring an export role.",
      "input": {
        "type": "object",
        "properties": {
          "documentId": { "type": "string", "format": "uuid" },
          "node": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "Exact nodes in artifact order. Several nodes can share one PDF file." },
          "format": { "enum": ["png", "svg", "pdf"] },
          "profile": { "enum": ["PDF/X-4"], "description": "PDF-only standards profile; fails closed until conformance is verified." },
          "scale": { "type": "number", "exclusiveMinimum": 0, "maximum": 8 },
          "destination": { "type": "string", "minLength": 1, "description": "Absolute path. A trailing / creates a new directory containing <nodeId>.<format> per node; otherwise use this exact filename. Existing destinations and filename collisions are errors." },
          "modes": { "type": "object", "additionalProperties": { "type": "string" } }
        },
        "required": ["documentId", "node", "format", "destination"],
        "additionalProperties": false
      },
      "output": { "type": "object", "additionalProperties": true },
      "examples": [
        {
          "name": "Export one subtree as a two-times PNG",
          "input": {
            "documentId": "092d8d0f-8a53-4e95-b9ff-7ec6e222ddf9",
            "node": ["frame-1"],
            "format": "png",
            "scale": 2,
            "destination": "/Users/example/Downloads/frame-1.png"
          }
        }
      ],
      "handler": "documents.extract"
    },
    {
      "key": "documents.open",
      "summary": "Open one exact Canvas document in a new or explicitly targeted tab for the user.",
      "instructions": "Opening changes visible tab state but does not modify document content. Use documents.execute with TakeScreenshot for document visual inspection; open a tab when the user should view or work in the Canvas editor.",
      "input": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["documentId"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string"
          },
          "tabId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["documentId", "tabId"],
        "additionalProperties": false
      },
      "examples": [
        {
          "name": "Open a document for visual review",
          "input": {
            "documentId": "092d8d0f-8a53-4e95-b9ff-7ec6e222ddf9"
          }
        }
      ],
      "handler": "documents.open"
    },
    {
      "key": "documents.trash",
      "summary": "Move one owned Canvas document to recoverable Trash after explicit user authorization and exact current-title confirmation.",
      "instructions": "Resolve the exact current title with documents.list, obtain explicit authorization to move that document to Trash, and pass the title unchanged as confirmTitle. Edit or cleanup authorization does not imply moving the document to Trash. Agents cannot permanently delete Canvas documents.",
      "input": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string",
            "format": "uuid"
          },
          "confirmTitle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "required": ["documentId", "confirmTitle"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "trashed": {
            "const": true
          }
        },
        "required": ["documentId", "title", "trashed"],
        "additionalProperties": false
      },
      "examples": [
        {
          "name": "Move an explicitly confirmed test document to Trash",
          "input": {
            "documentId": "092d8d0f-8a53-4e95-b9ff-7ec6e222ddf9",
            "confirmTitle": "Canvas QA Test"
          }
        }
      ],
      "handler": "documents.trash"
    },
    {
      "key": "folders.list",
      "summary": "List accessible Canvas folders at the root, inside one parent, among recent folders, or in Trash.",
      "input": {
        "type": "object",
        "properties": {
          "view": { "enum": ["roots", "children", "recent", "trash"] },
          "parentId": { "type": ["string", "null"], "format": "uuid" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 500 }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": { "items": { "type": "array", "maxItems": 500, "items": { "type": "object", "additionalProperties": true } } },
        "required": ["items"],
        "additionalProperties": false
      },
      "examples": [{ "name": "List root folders", "input": { "view": "roots", "limit": 20 } }],
      "handler": "folders.list"
    },
    {
      "key": "folders.create",
      "summary": "Create a Canvas folder at the library root or inside one accessible parent folder.",
      "input": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 255 },
          "parentId": { "type": ["string", "null"], "format": "uuid" }
        },
        "required": ["name"],
        "additionalProperties": false
      },
      "output": { "type": "object", "additionalProperties": true },
      "examples": [{ "name": "Create a root folder", "input": { "name": "Project assets" } }],
      "handler": "folders.create"
    },
    {
      "key": "folders.rename",
      "summary": "Rename one owned Canvas folder without changing its contents.",
