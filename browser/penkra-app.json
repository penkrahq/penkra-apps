{
  "id": "com.penkra.browser",
  "slug": "browser",
  "name": "Browser",
  "summary": "Browse the web in isolated pages that agents and people can use together.",
  "version": "0.2.7",
  "compatibility": { "penkra": ">=0.11.11" },
  "icons": [
    { "src": "assets/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "entrypoints": { "tab": "app.html", "controller": "operations.js" },
  "permissions": [
    {
      "name": "browser-session",
      "required": true,
      "reason": "Browser uses Penkra's isolated hosted pages for navigation and automation."
    }
  ],
  "operations": [
    {
      "key": "pages.open",
      "summary": "Open one HTTP(S) URL in a Browser tab and return its tab/page state; use penkra open instead when the user did not choose Browser.",
      "instructionsPath": "operations/pages.open.md",
      "input": {
        "type": "object",
        "properties": { "url": { "type": "string", "minLength": 1 } },
        "required": ["url"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "tabId": { "type": "string", "minLength": 1 },
          "activePageId": { "type": "string", "minLength": 1 },
          "pages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "url": { "type": "string" },
                "title": { "type": "string" },
                "status": { "enum": ["live", "suspended"] }
              },
              "required": ["id", "url", "title", "status"],
              "additionalProperties": true
            }
          }
        },
        "required": ["tabId", "activePageId", "pages"],
        "additionalProperties": true
      },
      "examples": [{ "name": "Open the Penkra website", "input": { "url": "https://penkra.com" } }],
      "handler": "pages.open"
    },
    {
      "key": "pages.navigate",
      "summary": "Navigate an existing page in the explicitly targeted Browser tab; use a current pageId when choosing among multiple pages and snapshot again afterward.",
      "instructionsPath": "operations/pages.navigate.md",
      "input": {
        "type": "object",
        "properties": {
          "url": { "type": "string", "minLength": 1 },
          "pageId": { "type": "string", "minLength": 1 }
        },
        "required": ["url"],
        "additionalProperties": false
      },
      "output": { "type": "object", "additionalProperties": true },
      "examples": [{ "name": "Navigate the targeted tab's current page", "input": { "url": "https://penkra.com/docs" } }],
      "handler": "pages.navigate"
    },
    {
      "key": "pages.evaluate",
      "summary": "Evaluate one bounded JavaScript expression in an exact page and targeted Browser tab; use only when semantic operations and tab observation cannot express the task.",
      "instructionsPath": "operations/pages.evaluate.md",
      "input": {
        "type": "object",
        "properties": {
          "pageId": { "type": "string", "minLength": 1 },
          "expression": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          }
        },
        "required": ["pageId", "expression"],
        "additionalProperties": false
      },
      "output": {},
      "examples": [{ "name": "Read the current page title", "input": { "pageId": "page_01HXYZ", "expression": "document.title" } }],
      "handler": "pages.evaluate"
    },
    {
      "key": "pages.close",
      "summary": "Close one page in the explicitly targeted Browser tab; use its exact pageId and rediscover Browser state if it is stale.",
      "instructionsPath": "operations/pages.close.md",
      "input": {
        "type": "object",
        "properties": { "pageId": { "type": "string", "minLength": 1 } },
        "required": ["pageId"],
        "additionalProperties": false
      },
      "output": { "type": "object", "additionalProperties": true },
      "examples": [{ "name": "Close an exact browser page", "input": { "pageId": "page_01HXYZ" } }],
      "handler": "pages.close"
    }
  ],
  "contributions": {
    "handlers": [
      {
        "intent": "open-url",
        "operation": "pages.open",
        "schemes": ["http", "https"]
      }
    ]
  }
}
