{
  "id": "com.penkra.explorer",
  "slug": "explorer",
  "name": "Explorer",
  "summary": "Browse, search, preview, and manage files through scoped Penkra access.",
  "version": "0.2.8",
  "compatibility": { "penkra": ">=0.11.11" },
  "icons": [
    { "src": "assets/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "entrypoints": { "tab": "app.html", "controller": "operations.js" },
  "operations": [
    {
      "key": "resources.open",
      "summary": "Open one host-minted file or directory handle in Explorer and return its tabId; use penkra open first when you have only a path, never a handle.",
      "input": {
        "type": "object",
        "properties": {
          "handleId": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["file", "directory"] },
          "name": { "type": "string", "minLength": 1 }
        },
        "required": ["handleId", "kind", "name"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": { "tabId": { "type": "string", "minLength": 1 } },
        "required": ["tabId"],
        "additionalProperties": false
      },
      "examples": [{ "name": "Open a host-approved project directory", "input": { "handleId": "handle_01HXYZ", "kind": "directory", "name": "Penkra" } }],
      "handler": "resources.open"
    }
  ],
  "contributions": {
    "handlers": [
      {
        "intent": "open-file",
        "operation": "resources.open",
        "extensions": [
          ".bash",
          ".c",
          ".cc",
          ".conf",
          ".cpp",
          ".cs",
          ".css",
          ".csv",
          ".gif",
          ".go",
          ".h",
          ".hpp",
          ".html",
          ".ini",
          ".java",
          ".jpeg",
          ".jpg",
          ".js",
          ".json",
          ".json5",
          ".jsonc",
          ".jsx",
          ".log",
          ".md",
          ".mdown",
          ".mjs",
          ".mts",
          ".pdf",
          ".php",
          ".png",
          ".properties",
          ".py",
          ".rb",
          ".rs",
          ".scss",
          ".sh",
          ".sql",
          ".svg",
          ".toml",
          ".ts",
          ".tsv",
          ".tsx",
          ".txt",
          ".webp",
          ".xml",
          ".yaml",
          ".yml",
          ".zsh"
        ]
      },
      { "intent": "open-directory", "operation": "resources.open" }
    ]
  }
}
