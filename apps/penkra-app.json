{
  "manifestVersion": 1,
  "id": "com.penkra.apps",
  "slug": "apps",
  "name": "Apps",
  "summary": "Discover, install, update, and manage Apps in Penkra.",
  "version": "0.1.0",
  "compatibility": {
    "penkra": ">=0.8.0"
  },
  "icons": [
    {
      "src": "assets/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "entrypoints": {
    "app": "app.html"
  }
}
