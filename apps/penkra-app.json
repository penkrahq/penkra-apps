{
  "manifestVersion": 2,
  "id": "com.penkra.apps",
  "slug": "apps",
  "name": "Apps",
  "summary": "Discover, install, update, and manage Apps in Penkra.",
  "version": "0.2.5",
  "compatibility": {
    "penkra": ">=0.11.11"
  },
  "icons": [
    {
      "src": "assets/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "entrypoints": {
    "app": "app.html",
    "operations": "operations.js"
  },
  "operations": [
    {
      "key": "listings.open",
      "summary": "Read one exact registry App/version and its permissions before install or update; this does not change local state.",
      "input": {
        "type": "object",
        "properties": { "appId": { "type": "string", "minLength": 1 } },
        "required": ["appId"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "appId": { "type": "string" },
          "tabId": { "type": "string" }
        },
        "required": ["appId", "tabId"],
        "additionalProperties": false
      },
      "examples": [{ "name": "Inspect the Canvas listing", "input": { "appId": "com.penkra.canvas" } }],
      "handler": "listings.open"
    },
    {
      "key": "installations.install",
      "summary": "Install one exact registry version into the current Space after the user grants every declared permission; verify the returned snapshot before claiming it is usable.",
      "input": {
        "$ref": "#/$defs/installInput",
        "$defs": {
          "installInput": {
            "type": "object",
            "properties": {
              "slug": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "permissions": { "$ref": "#/$defs/grants" }
            },
            "required": ["slug", "version", "permissions"],
            "additionalProperties": false
          },
          "grants": {
            "type": "object",
            "additionalProperties": { "enum": ["denied", "granted"] }
          }
        }
      },
      "output": {
        "$ref": "#/$defs/result",
        "$defs": {
          "result": {
            "type": "object",
            "properties": {
              "appId": { "type": "string" },
              "spaceId": { "type": "string" },
              "state": { "const": "installed" },
              "version": { "type": "string" }
            },
            "required": ["appId", "spaceId", "state", "version"],
            "additionalProperties": false
          }
        }
      },
      "examples": [{ "name": "Install Canvas with its required permissions", "input": { "slug": "canvas", "version": "0.2.19", "permissions": { "account-data": "granted", "network-fetch": "granted" } } }],
      "handler": "installations.install"
    },
    {
      "key": "installations.update",
      "summary": "Update an installed App in the current Space to one exact registry version; newly declared permissions require explicit grants.",
      "input": {
        "type": "object",
        "properties": {
          "slug": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "permissions": {
            "type": "object",
            "additionalProperties": { "enum": ["denied", "granted"] }
          }
        },
        "required": ["slug", "version", "permissions"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "appId": { "type": "string" },
          "spaceId": { "type": "string" },
          "state": { "const": "updated" },
          "version": { "type": "string" }
        },
        "required": ["appId", "spaceId", "state", "version"],
        "additionalProperties": false
      },
      "examples": [{ "name": "Update Canvas to an exact version", "input": { "slug": "canvas", "version": "0.2.21", "permissions": { "account-data": "granted", "network-fetch": "granted" } } }],
      "handler": "installations.update"
    },
    {
      "key": "installations.uninstall",
      "summary": "Uninstall one App from the current Space with an explicit retainData choice; use remove-data separately when retained data must later be erased.",
      "input": {
        "type": "object",
        "properties": {
          "appId": { "type": "string", "minLength": 1 },
          "retainData": { "type": "boolean" }
        },
        "required": ["appId", "retainData"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "appId": { "type": "string" },
          "spaceId": { "type": "string" },
          "state": { "const": "uninstalled" }
        },
        "required": ["appId", "spaceId", "state"],
        "additionalProperties": false
      },
      "examples": [{ "name": "Uninstall Canvas while retaining its data", "input": { "appId": "com.penkra.canvas", "retainData": true } }],
      "handler": "installations.uninstall"
    },
    {
      "key": "installations.enable",
      "summary": "Enable one already-installed App in the current Space; installation and permission grants are separate prerequisites.",
      "input": {
        "type": "object",
        "properties": { "appId": { "type": "string", "minLength": 1 } },
        "required": ["appId"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "appId": { "type": "string" },
          "spaceId": { "type": "string" },
          "state": { "const": "enabled" },
          "version": { "type": "string" }
        },
        "required": ["appId", "spaceId", "state", "version"],
        "additionalProperties": false
      },
      "examples": [{ "name": "Enable Canvas in the current Space", "input": { "appId": "com.penkra.canvas" } }],
      "handler": "installations.enable"
    },
    {
      "key": "installations.disable",
      "summary": "Disable one installed App in the current Space without uninstalling it or erasing retained data.",
      "input": {
        "type": "object",
        "properties": { "appId": { "type": "string", "minLength": 1 } },
        "required": ["appId"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "appId": { "type": "string" },
          "spaceId": { "type": "string" },
          "state": { "const": "disabled" },
          "version": { "type": "string" }
        },
        "required": ["appId", "spaceId", "state", "version"],
        "additionalProperties": false
      },
      "examples": [{ "name": "Disable Canvas in the current Space", "input": { "appId": "com.penkra.canvas" } }],
      "handler": "installations.disable"
    },
    {
      "key": "installations.remove-data",
      "summary": "Permanently remove one inactive App's retained data from the current Space; disable it first and use only after explicit erasure authorization.",
      "input": {
        "type": "object",
        "properties": { "appId": { "type": "string", "minLength": 1 } },
        "required": ["appId"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "appId": { "type": "string" },
          "spaceId": { "type": "string" },
          "state": { "const": "data-removed" }
        },
        "required": ["appId", "spaceId", "state"],
        "additionalProperties": false
      },
      "examples": [{ "name": "Erase retained Canvas data", "input": { "appId": "com.penkra.canvas" } }],
      "handler": "installations.remove-data"
    }
  ]
}
