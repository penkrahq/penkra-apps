{
  "manifestVersion": 1,
  "id": "com.penkra.apps",
  "slug": "apps",
  "name": "Apps",
  "summary": "Discover, install, update, and manage Apps in Penkra.",
  "version": "0.1.3",
  "compatibility": {
    "penkra": ">=0.8.0"
  },
  "icons": [
    {
      "src": "assets/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "entrypoints": {
    "app": "app.html",
    "operations": "operations.html"
  },
  "operations": [
    {
      "key": "listings.open",
      "summary": "Open an App's registry listing without installing it.",
      "input": { "type": "object", "properties": { "appId": { "type": "string", "minLength": 1 } }, "required": ["appId"], "additionalProperties": false },
      "output": { "type": "object", "properties": { "appId": { "type": "string" }, "tabId": { "type": "string" } }, "required": ["appId", "tabId"], "additionalProperties": false },
      "handler": "listings.open"
    },
    {
      "key": "installations.install",
      "summary": "Install a registry App into the current Space.",
      "input": { "$ref": "#/$defs/installInput", "$defs": { "installInput": { "type": "object", "properties": { "slug": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "permissions": { "$ref": "#/$defs/grants" } }, "required": ["slug", "version", "permissions"], "additionalProperties": false }, "grants": { "type": "object", "additionalProperties": { "enum": ["denied", "granted"] } } } },
      "output": { "$ref": "#/$defs/result", "$defs": { "result": { "type": "object", "properties": { "appId": { "type": "string" }, "spaceId": { "type": "string" }, "state": { "const": "installed" }, "version": { "type": "string" } }, "required": ["appId", "spaceId", "state", "version"], "additionalProperties": false } } },
      "handler": "installations.install"
    },
    {
      "key": "installations.update",
      "summary": "Update a registry App in the current Space with explicit permission grants.",
      "input": { "type": "object", "properties": { "slug": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "permissions": { "type": "object", "additionalProperties": { "enum": ["denied", "granted"] } } }, "required": ["slug", "version", "permissions"], "additionalProperties": false },
      "output": { "type": "object", "properties": { "appId": { "type": "string" }, "spaceId": { "type": "string" }, "state": { "const": "updated" }, "version": { "type": "string" } }, "required": ["appId", "spaceId", "state", "version"], "additionalProperties": false },
      "handler": "installations.update"
    },
    {
      "key": "installations.uninstall",
      "summary": "Uninstall an App while explicitly choosing whether to retain its data.",
      "input": { "type": "object", "properties": { "appId": { "type": "string", "minLength": 1 }, "retainData": { "type": "boolean" } }, "required": ["appId", "retainData"], "additionalProperties": false },
      "output": { "type": "object", "properties": { "appId": { "type": "string" }, "spaceId": { "type": "string" }, "state": { "const": "uninstalled" } }, "required": ["appId", "spaceId", "state"], "additionalProperties": false },
      "handler": "installations.uninstall"
    },
    {
      "key": "installations.enable",
      "summary": "Enable an installed App in the current Space.",
      "input": { "type": "object", "properties": { "appId": { "type": "string", "minLength": 1 } }, "required": ["appId"], "additionalProperties": false },
      "output": { "type": "object", "properties": { "appId": { "type": "string" }, "spaceId": { "type": "string" }, "state": { "const": "enabled" }, "version": { "type": "string" } }, "required": ["appId", "spaceId", "state", "version"], "additionalProperties": false },
      "handler": "installations.enable"
    },
    {
      "key": "installations.disable",
      "summary": "Disable an installed App in the current Space.",
      "input": { "type": "object", "properties": { "appId": { "type": "string", "minLength": 1 } }, "required": ["appId"], "additionalProperties": false },
      "output": { "type": "object", "properties": { "appId": { "type": "string" }, "spaceId": { "type": "string" }, "state": { "const": "disabled" }, "version": { "type": "string" } }, "required": ["appId", "spaceId", "state", "version"], "additionalProperties": false },
      "handler": "installations.disable"
    },
    {
      "key": "installations.remove-data",
      "summary": "Remove retained App data from the current Space.",
      "input": { "type": "object", "properties": { "appId": { "type": "string", "minLength": 1 } }, "required": ["appId"], "additionalProperties": false },
      "output": { "type": "object", "properties": { "appId": { "type": "string" }, "spaceId": { "type": "string" }, "state": { "const": "data-removed" } }, "required": ["appId", "spaceId", "state"], "additionalProperties": false },
      "handler": "installations.remove-data"
    }
  ]
}
